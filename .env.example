# SOC-QA Intelligence Environment Configuration
APP_NAME="SOC-QA Intelligence"
APP_ENV="development"
APP_VERSION="1.0.0-research"
API_PREFIX="/api/v1"

# Database Configuration (PostgreSQL primary; automatic local SQLite fallback when Docker is unavailable)
DATABASE_URL="postgresql://socqa_user:socqa_research_pass@localhost:5432/socqa_intelligence"
SQLITE_FALLBACK_PATH="./data/socqa_research.db"
USE_SQLITE_FALLBACK="true"

# Security & Ingestion Guardrails
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_EXTENSIONS=".csv,.json,.jsonl,.ndjson,.xes"
RAW_STORAGE_DIR="./data/raw"
NORMALIZED_STORAGE_DIR="./data/normalized"
EXPORT_STORAGE_DIR="./data/exports"
SECRET_KEY="change-this-in-production-use-openssl-rand-hex-32"

# Explainable AI Module Configuration (Disabled by default per research protocol)
AI_MODULE_ENABLED="false"
AI_PROVIDER="disabled"
AI_MODEL_NAME="none"
AI_API_KEY=""
AI_OLLAMA_BASE_URL="http://localhost:11434"
AI_PROMPT_VERSION="v1.0-audit-strict"

ALLOWED_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000"
